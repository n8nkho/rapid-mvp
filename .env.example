# Required: Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Optional: direct PostgreSQL (for /admin/migrate auto-migration)
# DATABASE_URL=postgresql://user:pass@host:5432/postgres

# Optional: LLM features (gap analysis, extraction)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: CORS allowed origins (comma-separated). Default: rapid-ui Vercel + localhost:3000
# CORS_ORIGINS=https://rapid-ui-wine.vercel.app,http://localhost:3000

# Optional: protect admin endpoints (set to a secret; send as X-Admin-Key header)
# ADMIN_API_KEY=your-secret

# Optional: require API key for all /v1 routes (send X-API-Key or Authorization: Bearer <key>)
# API_KEY=your-api-key
